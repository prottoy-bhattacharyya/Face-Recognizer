{
  "openapi": "3.0.0",
  "info": {
    "title": "Face_Recognition",
    "description": "Face Recognition API for enrolling and verifying users via camera.",
    "contact": {
      "email": "prottoyvhattacharyya@gmail.com"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://virtserver.swaggerhub.com/prottoy/Face_Recognition/1.0.0",
      "description": "SwaggerHub API Auto Mocking"
    },
    {
      "url": "http://localhost:8000",
      "description": "Face Recognition API"
    }
  ],
  "tags": [
    {
      "name": "Device",
      "description": "Hardware and camera-related operations"
    },
    {
      "name": "developers",
      "description": "Operations available to regular developers"
    }
  ],
  "paths": {
    "/enroll_face/{name}": {
      "post": {
        "tags": [
          "Device"
        ],
        "summary": "Enroll a new face",
        "description": "Starts the camera, captures photos, and adds the specified user to the database.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Name of the person being enrolled",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "User successfully enrolled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_201"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request (e.g., camera failed, name already exists)"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/verify": {
      "get": {
        "tags": [
          "Device"
        ],
        "summary": "Verify a user",
        "description": "Triggers the camera to verify the user against the database using a specified confidence threshold.",
        "parameters": [
          {
            "name": "threshold",
            "in": "query",
            "description": "Value of the model confidence threshold parameter (0.0 to 1.0)",
            "required": false,
            "schema": {
              "type": "number",
              "format": "float"
            },
            "example": 0.5
          }
        ],
        "responses": {
          "200": {
            "description": "User successfully verified",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_201"
                }
              }
            }
          },
          "400": {
            "description": "Client Error (e.g., face not detected, threshold invalid)"
          },
          "401": {
            "description": "Unauthorized (Verification failed)"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/remove/{name}": {
      "delete": {
        "tags": [
          "Device"
        ],
        "summary": "Remove a specific face",
        "description": "Removes the specified user's face data from the database.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Name of the person to remove",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User successfully removed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_200"
                }
              }
            }
          },
          "404": {
            "description": "Not Found (The user does not exist in the database)"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/removeAll": {
      "delete": {
        "tags": [
          "Device"
        ],
        "summary": "Reset database (Delete all faces)",
        "description": "Removes all enrolled faces from the database and resets the system.",
        "responses": {
          "200": {
            "description": "Database successfully reset",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_200_1"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "inline_response_201": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "name": {
            "type": "string",
            "example": "Prottoy"
          }
        }
      },
      "inline_response_200": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "message": {
            "type": "string",
            "example": "User has been successfully removed."
          }
        }
      },
      "inline_response_200_1": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "message": {
            "type": "string",
            "example": "All faces have been successfully removed."
          }
        }
      }
    }
  }
}